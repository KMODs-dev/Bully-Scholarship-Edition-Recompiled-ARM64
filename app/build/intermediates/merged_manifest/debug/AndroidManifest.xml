<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bully.pc"
    android:versionCode="1"
    android:versionName="0.7" >

    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="33" />

    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />
    <!-- ler a pasta do jogo fora da pasta do app (escolhida no launcher) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <queries>
        <package android:name="com.itsaky.androidide" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.itsaky.androidide.permission.BIND_LOG_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:hasCode="true"
        android:isGame="true"
        android:label="Bully PC"
        android:requestLegacyExternalStorage="true" >
        <activity
            android:name="com.bully.pc.LauncherActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.bully.pc.BullyActivity"
            android:configChanges="keyboardHidden|keyboard|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|navigation"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" >
        </activity>

        <provider
            android:name="com.itsaky.androidide.logsender.utils.LogSenderInstaller"
            android:authorities="com.bully.pc.logsender-installer"
            android:enabled="@bool/logsender_enabled"
            android:exported="false" />

        <service
            android:name="com.itsaky.androidide.logsender.LogSenderService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>